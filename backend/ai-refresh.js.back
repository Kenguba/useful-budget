// ============================================================
// AI 商铺后端 ai-refresh 的源码留档副本。
// 真正运行的是部署在 Cloudflare（站长账号）上的 Worker
// 「ai-refresh」，守在路由 ai.xxxxx.asia/api/* 上，三个接口：
//   POST /api/refresh-board  手动全量刷新（5 分钟全局冷却）
//   GET  /api/stock-check    进站库存现核（60 秒节流，结果存 KV）
//   GET  /api/stock-status   给 GitHub 轻量任务读访客核对结果
// 另有 Cron 触发器 * * * * *（每分钟）：scheduled() 检查数据
// 新鲜度，过期（超 10 分钟）或仓库无数据时触发一次全量拉取。
// 把副本放在仓库里，是为了迁移时直接拿这一份部署，不用去控制台翻。
// 同步规则：线上代码有任何改动，先部署到 Cloudflare，再同步回本文件。
//
// （缺了会出事）
// 1. KV 绑定：Worker 须绑 KV 命名空间 ai-refresh-kv，变量名 REFRESH_KV。
//    键：last = 上次全量触发时间戳；last:src = 触发来源（manual/auto）；
//    stock:<分组id> = 该组最近一次现核结果（10 分钟过期）；
//    stock:lastcheck = 最近一次现核时间戳。
// 2. 密钥：Worker secret GH_TOKEN = 细粒度 PAT，仅授权本仓库、
//    Actions 读写；PAT 过期则触发失败（前端报「刷新服务暂不可用」）。
// 3. 路由：ai 子域名下 /api/* 绑到本 Worker（这些路径的请求不再走
//    site-router 的 Pages 转发）。
// 4. Cron 触发器：须在 Worker 设置里加 Cron * * * * *，否则
//    scheduled 自愈永不执行（代码里有 scheduled 不等于已启用）。
// 5. 冷却与防并发（2026-11-03 竞态风暴后定版）：
//    - 自愈只走 Cron 单线程入口，访客请求（现核/按钮）不触发自愈；
//    - 手动触发走 triggerFullRefresh：优先 Durable Object
//      「RefreshGate」全局单实例（强一致真串行）；DO 绑定未建时
//      退回 triggerLegacy：同节点内存锁 + KV 先占位 + 占位后
//      延迟 2-4 秒随机错峰复核 + 在途检查 + 失败回滚占位。
//    背景：KV 最终一致、Worker 并发分多实例，单纯「查完再写」
//    拦不住同秒并发（00:59 曾同秒打出十几发 dispatch）。
//    注意：网页版控制台建不了第一个 DO 命名空间（类下拉为空），
//    REFRESH_GATE 绑定需用 Wrangler 带 new_sqlite_classes 迁移
//    部署创建；代码已按「无绑定自动退回」写好，不会因缺绑定而坏。
// 6. 现核口径与 refresh.py / stock_check.py 一致：只核可读平台
//    （16688 接口 / aicdks / /item/ 系，wzyp 被 WAF 挡跳过）；
//    「商品不存在」/404 返回 -1（找不到，消费端据此去除条目），
//    售罄返回 0（同样去除），暂时读不到返回 null（保留原值）。
// ============================================================
// ai-shop 后端（Worker: ai-refresh）
// POST /api/refresh-board  手动刷新：5 分钟全局冷却（KV）后触发 GitHub 全量刷新（refresh-and-deploy）；
//                          KV 读不到时查 GitHub 运行记录兜底；KV 放行时触发前再用 GitHub 记录复核（ken 2026-11-02 定）。
// GET  /api/stock-check?group=<分组id>
//                          进站库存现核：按 board.json 里存的详情页链接逐条直查可读平台的实时库存
//                          （16688 接口 / aicdks / /item/ 系；wzyp 被 WAF 挡跳过）；60 秒内共用上次结果（KV 节流）。
//                          现核只做现核、不再顺带触发全量拉取；过期自愈由 Worker 每分钟
//                          Cron（scheduled）单线程执行：超 10 分钟没更新或仓库无数据才拉全量。
// GET  /api/stock-status   给 GitHub 轻量任务读：返回 KV 里最近访客核对的时间与各组结果，
//                          服务器据此「采用最新核对」落盘，不重复核（5 分钟防抖锚定最新一次核对）。
const REPO = 'Kenguba/useful-budget';
const WORKFLOW = 'refresh.yml';
const COOLDOWN_MS = 300 * 1000;
const STOCK_TTL_MS = 60 * 1000;
const STOCK_STALE_MS = 600 * 1000;
const BOARD_URL = 'https://kenguba.github.io/useful-budget/frontend/ai-shop/data/board.json';
const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36';

function cors() {
  return {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, GET, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  };
}
function json(obj, status = 200) {
  return new Response(JSON.stringify(obj), {
    status,
    headers: { 'Content-Type': 'application/json', ...cors() },
  });
}
function ghHeaders(env) {
  return {
    'Authorization': 'Bearer ' + env.GH_TOKEN,
    'Accept': 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
    'User-Agent': 'ai-refresh-worker',
  };
}
// 从 GitHub 运行记录取最近一次手动触发（workflow_dispatch）的时间；查不到返回 0
async function lastFromGitHub(env) {
  try {
    const r = await fetch(`https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/runs?event=workflow_dispatch&per_page=1`, {
      headers: ghHeaders(env),
    });
    if (!r.ok) return 0;
    const d = await r.json();
    const run = (d.workflow_runs || [])[0];
    return run ? (Date.parse(run.created_at) || 0) : 0;
  } catch (e) {
    return 0;
  }
}
async function lastSource(env) {
  try { return (await env.REFRESH_KV.get('last:src')) || null; } catch (e) { return null; }
}
// 是否已有全量刷新在跑/排队（任何来源）——有就不重复触发
async function refreshInFlight(env) {
  try {
    const r = await fetch(`https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/runs?per_page=5`, {
      headers: ghHeaders(env),
    });
    if (!r.ok) return false;
    const d = await r.json();
    return (d.workflow_runs || []).some(x => x.status === 'in_progress' || x.status === 'queued');
  } catch (e) {
    return false;
  }
}
// 触发全量刷新（refresh-board POST 与过期自愈共用）：{mode:'cooldown',retry_after,source} | {mode:'started'} | {mode:'error',status}
// 竞态修复（2026-11-03）：00:59 进站 8 路自愈同秒打出十几发 dispatch——旧版「先查冷却、
// 触发后才写时间戳」，并发请求会一起通过检查。第一层修复（KV 先占位 + 在途检查）实测仍拦不住
// 真并发：KV 是最终一致，同一瞬间到达的请求读到的都是旧值，占位互相看不见。
// 真正拦住同节点并发的是下面的内存锁：同一 Worker 实例内模块变量共享，且「查+占」之间
// 没有 await、JS 单线程内不可被打断，同节点同秒到达的请求被严格串行化；跨节点再靠
// KV 占位 + GitHub 在途/记录复核兜底（GitHub 并发组会取消多余运行，数据无风险）。
let memLast = 0;
let memSrc = null;
function triggerLegacy(env, src) {
  const now = Date.now();
  if (now - memLast < COOLDOWN_MS) {
    return Promise.resolve({
      mode: 'cooldown',
      retry_after: Math.ceil((COOLDOWN_MS - (now - memLast)) / 1000),
      source: memSrc,
    });
  }
  memLast = now;
  memSrc = src || 'manual';
  return triggerFullRefreshInner(env, src, now);
}
async function triggerFullRefreshInner(env, src, now) {
  let last = 0;
  try {
    last = parseInt((await env.REFRESH_KV.get('last')) || '0', 10) || 0;
  } catch (e) {
    // KV 没额度/不可用：转查 GitHub 运行记录兜底
    last = await lastFromGitHub(env);
  }
  if (now - last < COOLDOWN_MS) {
    return { mode: 'cooldown', retry_after: Math.ceil((COOLDOWN_MS - (now - last)) / 1000), source: await lastSource(env) };
  }
  // 先占位：先把本次触发写进 KV 占住冷却，再往下走
  try {
    await env.REFRESH_KV.put('last', String(now));
    await env.REFRESH_KV.put('last:src', src || 'manual');
  } catch (e) {}
  // 延迟复核：占位后等 2-4 秒（随机错峰）再往下查——并发者的占位与 dispatch 在这段时间里
  // 变得可见（KV 传播、GitHub 列表更新都需要时间），后到者复查撞上就让行。
  // 这是拿不到 Durable Object 绑定时的最强串行化（控制台建不了第一个 DO 命名空间）。
  await new Promise(r => setTimeout(r, 2000 + Math.floor(Math.random() * 2000)));
  try {
    const kv2 = parseInt((await env.REFRESH_KV.get('last')) || '0', 10) || 0;
    if (kv2 > now) {
      memLast = Math.max(memLast, kv2);
      return { mode: 'cooldown', retry_after: Math.max(1, Math.ceil((COOLDOWN_MS - (Date.now() - kv2)) / 1000)), source: await lastSource(env) };
    }
  } catch (e) {}
  // 已有全量刷新在途就不重复触发（占位保留，冷却照常生效）
  if (await refreshInFlight(env)) {
    return { mode: 'cooldown', retry_after: 60, source: await lastSource(env), inflight: true };
  }
  // KV 放行也要用 GitHub 运行记录复核：KV 写额度耗尽时 last 会停在旧值，只看 KV 会重复触发
  const ghLast = await lastFromGitHub(env);
  if (now - ghLast < COOLDOWN_MS) {
    memLast = Math.max(memLast, ghLast);
    try { await env.REFRESH_KV.put('last', String(ghLast)); } catch (e) {}
    return { mode: 'cooldown', retry_after: Math.ceil((COOLDOWN_MS - (now - ghLast)) / 1000), source: await lastSource(env) };
  }
  const r = await fetch(`https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches`, {
    method: 'POST',
    headers: ghHeaders(env),
    body: JSON.stringify({ ref: 'main' }),
  });
  if (r.status !== 204) {
    // 触发失败：回滚占位（KV 与内存锁都恢复），别把冷却白白锁死 5 分钟
    memLast = last;
    try { await env.REFRESH_KV.put('last', String(last)); } catch (e) {}
    return { mode: 'error', status: r.status };
  }
  return { mode: 'started' };
}

// 触发入口：优先走 Durable Object「RefreshGate」全局单实例（强一致、真串行）；
// 绑定不存在或调用失败时退回 triggerLegacy（内存锁 + KV，最终一致、尽力而为）。
async function triggerFullRefresh(env, src) {
  if (env.REFRESH_GATE) {
    try {
      const stub = env.REFRESH_GATE.get(env.REFRESH_GATE.idFromName('global'));
      const r = await stub.fetch('https://gate.local/trigger', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ src: src || 'manual' }),
      });
      if (r.ok) return await r.json();
    } catch (e) {}
  }
  return triggerLegacy(env, src);
}

// 全局唯一的触发闸门（Durable Object）：所有节点、所有访客的触发都汇到这一个实例，
// 实例内「查冷却 + 占位」同步完成、不可打断，从根本上杜绝并发重复触发。
// 冷却值存 DO 自带存储（强一致），同时镜像写 KV 供其他路径读取。
export class RefreshGate {
  constructor(state, env) {
    this.state = state;
    this.env = env;
    this.last = 0;
    this.src = null;
    state.blockConcurrencyWhile(async () => {
      this.last = (await state.storage.get('last')) || 0;
      this.src = (await state.storage.get('src')) || null;
    });
  }
  async save() {
    try { await this.state.storage.put({ last: this.last, src: this.src }); } catch (e) {}
  }
  async fetch(req) {
    let src = 'manual';
    try { src = (await req.json()).src || 'manual'; } catch (e) {}
    const now = Date.now();
    // —— 同步临界区：check-and-set 之间没有 await，单实例内不可打断 ——
    if (now - this.last < COOLDOWN_MS) {
      return json({ mode: 'cooldown', retry_after: Math.ceil((COOLDOWN_MS - (now - this.last)) / 1000), source: this.src });
    }
    const prev = this.last;
    this.last = now;
    this.src = src;
    // —— 临界区结束，以下与 triggerFullRefreshInner 同口径 ——
    await this.save();
    const env = this.env;
    try { await env.REFRESH_KV.put('last', String(now)); await env.REFRESH_KV.put('last:src', src); } catch (e) {}
    if (await refreshInFlight(env)) {
      return json({ mode: 'cooldown', retry_after: 60, source: this.src, inflight: true });
    }
    const ghLast = await lastFromGitHub(env);
    if (now - ghLast < COOLDOWN_MS) {
      this.last = Math.max(now, ghLast);
      await this.save();
      try { await env.REFRESH_KV.put('last', String(ghLast)); } catch (e) {}
      return json({ mode: 'cooldown', retry_after: Math.ceil((COOLDOWN_MS - (now - ghLast)) / 1000), source: await lastSource(env) });
    }
    const r = await fetch(`https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches`, {
      method: 'POST',
      headers: ghHeaders(env),
      body: JSON.stringify({ ref: 'main' }),
    });
    if (r.status !== 204) {
      this.last = prev;
      await this.save();
      try { await env.REFRESH_KV.put('last', String(prev)); } catch (e) {}
      return json({ mode: 'error', status: r.status });
    }
    return json({ mode: 'started' });
  }
}

async function fetchBoard() {
  try {
    const r = await fetch(BOARD_URL + '?v=' + Math.floor(Date.now() / 300000), { headers: { 'User-Agent': UA } });
    if (!r.ok) return null;
    return await r.json();
  } catch (e) {
    return null;
  }
}
// 'YYYY-MM-DD HH:MM'（北京时间）→ ms
function bjTs(s) {
  if (!s) return 0;
  const t = Date.parse(String(s).replace(' ', 'T') + '+08:00');
  return isNaN(t) ? 0 : t;
}
// 库存数据过期（>10 分钟）或仓库无数据 → 全量拉取（走冷却通道）。
// 由 scheduled（每分钟 Cron）调用：单线程、无访客并发，是唯一的自愈入口。
async function escalateIfStale(env, board) {
  try {
    let lastAct = 0;
    try { lastAct = parseInt((await env.REFRESH_KV.get('stock:lastcheck')) || '0', 10) || 0; } catch (e) {}
    const boardTs = board ? bjTs(board.stock_checked_at || board.updated_at) : 0;
    const fresh = Math.max(lastAct, boardTs);
    const empty = !board || !Array.isArray(board.groups) || board.groups.every(g => !g.items || !g.items.length);
    if (empty || Date.now() - fresh > STOCK_STALE_MS) await triggerFullRefresh(env, 'auto');
  } catch (e) {}
}

function verifiable(url) {
  try {
    const u = new URL(url);
    return u.hostname.includes('16688.com.cn') || u.hostname.includes('aicdks.com')
      || (u.pathname.includes('/item/') && !u.hostname.includes('wzyp'));
  } catch (e) {
    return false;
  }
}
function stripTags(s) {
  return String(s || '')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ');
}
async function fetchTimeout(url, opts, ms) {
  const c = new AbortController();
  const t = setTimeout(() => c.abort(), ms || 9000);
  try {
    return await fetch(url, { ...(opts || {}), signal: c.signal });
  } finally {
    clearTimeout(t);
  }
}
// 与 refresh.py 同口径：能读的详情页逐条核；读不到返回 null
async function detailStock(url) {
  try {
    const u = new URL(url);
    if (u.hostname.includes('16688.com.cn')) {
      const m = url.match(/\/goods\/(G\d+)/);
      if (!m) return null;
      const r = await fetchTimeout('https://www.16688.com.cn/shopApi/goods/detail', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'User-Agent': UA },
        body: JSON.stringify({ goods_no: m[1] }),
      });
      if (!r.ok) return null;
      const d = await r.json();
      // 明确「商品不存在」→ -1（找不到，与暂时读不到的 null 区分；消费端据此去除条目）
      if (d && !d.data && String(d.msg || '').includes('不存在')) return -1;
      const q = d && d.data ? d.data.stock_available_quantity : null;
      return (typeof q === 'number' && isFinite(q)) ? Math.trunc(q) : null;
    }
    if (u.hostname.includes('aicdks.com') || (u.pathname.includes('/item/') && !u.hostname.includes('wzyp'))) {
      const r = await fetchTimeout(url, { headers: { 'User-Agent': UA } });
      if (r.status === 404) return -1;
      if (!r.ok) return null;
      const txt = stripTags(await r.text());
      if (txt.includes('售罄') || txt.includes('已售完')) return 0;
      const km = txt.match(/库存\s*[:：]?\s*(\d+)/);
      return km ? parseInt(km[1], 10) : null;
    }
  } catch (e) {}
  return null;
}

async function handleStockCheck(req, env, ctx) {
  const group = new URL(req.url).searchParams.get('group') || '';
  const board = await fetchBoard();
  if (!board) return json({ ok: false, error: 'board unavailable' }, 502);
  const grp = (board.groups || []).find(g => g.id === group);
  if (!grp) return json({ ok: false, error: 'unknown group' }, 404);
  // 注意：这里不再顺带触发过期自愈——自愈已搬到 Worker 每分钟 Cron（scheduled），
  // 单线程执行、天然无并发；访客请求只做现核本身（修 00:59 风暴的源头）。
  const now = Date.now();
  const key = 'stock:' + group;
  try {
    const c = await env.REFRESH_KV.get(key, 'json');
    if (c && c.board_updated_at === board.updated_at && now - c.t < STOCK_TTL_MS) {
      return json({ ok: true, group, board_updated_at: board.updated_at, checked_at: c.t, cached: true, results: c.results });
    }
  } catch (e) {}
  const items = (grp.items || []).filter(it => it && verifiable(it.url));
  const results = {};
  await Promise.all(items.map(async it => { results[it.url] = await detailStock(it.url); }));
  try {
    await env.REFRESH_KV.put(key, JSON.stringify({ t: now, board_updated_at: board.updated_at, results }), { expirationTtl: 600 });
  } catch (e) {}
  try { await env.REFRESH_KV.put('stock:lastcheck', String(now)); } catch (e) {}
  return json({ ok: true, group, board_updated_at: board.updated_at, checked_at: now, cached: false, results });
}

async function handleStockStatus(env) {
  const board = await fetchBoard();
  let lastcheck = 0;
  try { lastcheck = parseInt((await env.REFRESH_KV.get('stock:lastcheck')) || '0', 10) || 0; } catch (e) {}
  const groups = {};
  if (board && Array.isArray(board.groups)) {
    for (const g of board.groups) {
      try {
        const c = await env.REFRESH_KV.get('stock:' + g.id, 'json');
        if (c) groups[g.id] = c;
      } catch (e) {}
    }
  }
  return json({ ok: true, lastcheck, board_updated_at: board ? board.updated_at : null, groups });
}

export default {
  // 每分钟自愈检查（Cron 触发器 * * * * *）：数据过期/仓库无数据才拉全量
  async scheduled(event, env, ctx) {
    ctx.waitUntil(escalateIfStale(env, await fetchBoard()));
  },
  async fetch(req, env, ctx) {
    const url = new URL(req.url);
    if (url.pathname === '/api/refresh-board') {
      if (req.method === 'OPTIONS') return new Response(null, { headers: cors() });
      if (req.method !== 'POST') return json({ ok: false, error: 'method not allowed' }, 405);
      const r = await triggerFullRefresh(env, 'manual');
      if (r.mode === 'error') return json({ ok: false, error: 'dispatch failed', status: r.status }, 502);
      return json({ ok: true, mode: r.mode, ...(r.retry_after ? { retry_after: r.retry_after } : {}), ...(r.source ? { source: r.source } : {}) });
    }
    if (url.pathname === '/api/stock-check') {
      if (req.method === 'OPTIONS') return new Response(null, { headers: cors() });
      if (req.method !== 'GET') return json({ ok: false, error: 'method not allowed' }, 405);
      return handleStockCheck(req, env, ctx);
    }
    if (url.pathname === '/api/stock-status') {
      if (req.method === 'OPTIONS') return new Response(null, { headers: cors() });
      if (req.method !== 'GET') return json({ ok: false, error: 'method not allowed' }, 405);
      return handleStockStatus(env);
    }
    return new Response('not found', { status: 404 });
  },
};
