[Unit]
Description=dnsleak authoritative DNS for ip-check leak test
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/deploy/dnsleak/dnsleak_server.py
Environment=DNSLEAK_ZONE=leak.jpedu.asia
Environment=DNSLEAK_A=128.1.x.x
Environment=DNS_PORT=53
Environment=DNS_BIND=10.35.x.x
Environment=HTTP_PORT=8053
User=deploy
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
